# ─── Required ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL 16. In production, connect as a role that is NOT the table owner so the
# row-level security policies apply (the migration creates `nakhla_app` for this).
DATABASE_URL="postgresql://nakhla:change-me@localhost:5432/nakhla_erp?schema=public"

# 32 bytes, base64. Encrypts ZATCA private keys and CSIDs, employee IBANs and identity
# numbers, webhook secrets, and the nightly backup archive.
#   openssl rand -base64 32
# Losing this key means losing access to every encrypted value. Back it up separately from
# the database, and never commit it.
ENCRYPTION_KEY=""

# ─── Strongly recommended ─────────────────────────────────────────────────────────────────

# Redis, for the background worker. Without it the worker falls back to a database sweep,
# which still submits every invoice — just on a timer rather than immediately.
REDIS_URL="redis://localhost:6379"

# ─── ZATCA ────────────────────────────────────────────────────────────────────────────────

# sandbox | simulation | production. Set per tenant in Settings → ZATCA; this is the default
# for a newly created tenant.
ZATCA_DEFAULT_ENVIRONMENT="sandbox"

# How often the worker sweeps for submissions that are due for another attempt.
ZATCA_SWEEP_INTERVAL_MS="60000"
ZATCA_CONCURRENCY="4"

# ─── Object storage (attachments, backups) ────────────────────────────────────────────────

# Any S3-compatible store. For data residency, use a bucket inside Saudi Arabia — see the
# note in README.md.
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="me-south-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

BACKUP_DIR="./backups"
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""

# ─── Email ────────────────────────────────────────────────────────────────────────────────

# Either a Resend API key, or SMTP settings. Leave both blank to disable outbound email.
RESEND_API_KEY=""
SMTP_URL=""
MAIL_FROM="Nakhla ERP <no-reply@example.sa>"

# ─── WhatsApp Business ────────────────────────────────────────────────────────────────────

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
# Template names registered with Meta, one per message type, in Arabic and English.
WHATSAPP_TEMPLATE_INVOICE="invoice_issued"
WHATSAPP_TEMPLATE_REMINDER="payment_reminder"
WHATSAPP_TEMPLATE_PURCHASE_ORDER="purchase_order"

# ─── Payment gateway ──────────────────────────────────────────────────────────────────────

# Moyasar by default; HyperPay, Tap and STC Pay use the same webhook shape.
PAYMENT_PROVIDER="moyasar"
PAYMENT_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""

# ─── Application ──────────────────────────────────────────────────────────────────────────

NODE_ENV="development"
# Public origin, used in invoice links sent by email and WhatsApp.
APP_URL="http://localhost:3000"
