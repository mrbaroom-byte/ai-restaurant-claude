// Nakhla ERP — data model.
//
// Conventions applied everywhere:
//   • every business table carries tenantId and the created/updated audit columns
//   • money is Decimal(18, 4); quantity is Decimal(18, 6); never Float
//   • deletedAt exists only where a DRAFT document may legitimately be discarded
//   • posted documents are immutable: they are reversed or credited, never edited
//
// Row-level security is enabled by the migration in prisma/migrations; the application also
// scopes every query by tenantId, so a mistake in one layer is caught by the other.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Core & settings ──────────────────────────────────────────────────────────────────────

enum ValuationMethod {
  WEIGHTED_AVERAGE
  FIFO
}

enum ZatcaEnvironment {
  SANDBOX
  SIMULATION
  PRODUCTION
}

model Tenant {
  id                 String           @id @default(uuid()) @db.Uuid
  legalNameEn        String
  legalNameAr        String
  tradeNameEn        String?
  tradeNameAr        String?
  /// Commercial registration number.
  crNumber           String?
  vatNumber          String?
  vatRegistered      Boolean          @default(true)
  /// Standard VAT rate as a fraction, e.g. 0.1500.
  vatRate            Decimal          @default("0.15") @db.Decimal(6, 4)
  baseCurrency       String           @default("SAR")
  /// Month the fiscal year starts in, 1-12.
  fiscalYearStart    Int              @default(1)
  valuationMethod    ValuationMethod  @default(WEIGHTED_AVERAGE)
  /// Locked once the first stock movement exists — changing it would restate history.
  valuationLocked    Boolean          @default(false)
  allowNegativeStock Boolean          @default(false)
  /// Rounding increment applied to the payable total. 0 means no rounding.
  roundingIncrement  Decimal          @default("0") @db.Decimal(6, 4)
  posEnabled         Boolean          @default(false)
  logoUrl            String?
  defaultLocale      String           @default("ar")
  timezone           String           @default("Asia/Riyadh")
  molEstablishmentId String?
  zatcaEnvironment   ZatcaEnvironment @default(SANDBOX)
  /// GOSI and payroll rates, stamped onto each payroll run. See src/lib/payroll/gosi.ts.
  payrollSettings    Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  branches      Branch[]
  users         User[]
  accounts      Account[]
  parties       Party[]
  items         Item[]
  invoices      Invoice[]
  addresses     Address[]
  certificates  ZatcaCertificate[]
  fiscalPeriods FiscalPeriod[]
  sequences     Sequence[]
  auditLogs     AuditLog[]
  employees     Employee[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]

  @@map("tenants")
}

model Branch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  /// Short code used in document numbers, e.g. JED.
  code         String
  nameEn       String
  nameAr       String
  isCostCentre Boolean  @default(true)
  addressId    String?  @db.Uuid
  phone        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  createdBy    String?  @db.Uuid
  updatedAt    DateTime @updatedAt
  updatedBy    String?  @db.Uuid

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address     Address?     @relation(fields: [addressId], references: [id])
  warehouses  Warehouse[]
  invoices    Invoice[]
  sequences   Sequence[]
  posSessions PosSession[]
  employees   Employee[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("branches")
}

model Address {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  /// Saudi National Address fields.
  buildingNumber   String?
  street           String?
  district         String?
  city             String?
  postalCode       String?
  additionalNumber String?
  region           String?
  countryCode      String   @default("SA")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branches Branch[]
  parties  Party[]

  @@index([tenantId])
  @@map("addresses")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  tenantId           String     @db.Uuid
  email              String
  /// Argon2id hash. Null for a user who signs in with a magic link only.
  passwordHash       String?
  nameEn             String
  nameAr             String?
  role               String
  /// Empty means every branch.
  branchIds          String[]   @db.Uuid
  extraPermissions   String[]
  revokedPermissions String[]
  locale             String     @default("ar")
  status             UserStatus @default(INVITED)
  /// TOTP secret, encrypted at rest. Mandatory for Owner and Accountant.
  totpSecret         String?
  totpEnabled        Boolean    @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  createdBy          String?    @db.Uuid
  updatedAt          DateTime   @updatedAt
  updatedBy          String?    @db.Uuid
  deletedAt          DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions      Session[]
  notifications Notification[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  tenantId    String    @db.Uuid
  tokenHash   String    @unique
  refreshHash String?   @unique
  ipAddress   String?
  userAgent   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Sequence {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  branchId    String?  @db.Uuid
  kind        String
  prefix      String
  resetYearly Boolean  @default(true)
  padding     Int      @default(6)
  lastNumber  Int      @default(0)
  year        Int
  gapFree     Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, kind])
  @@index([tenantId])
  @@map("sequences")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  userId    String?  @db.Uuid
  /// Table name, e.g. "invoices".
  entity    String
  entityId  String?  @db.Uuid
  action    String
  /// Field-level before/after. Sensitive values are redacted before storage.
  before    Json?
  after     Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

// ─── Ledger ───────────────────────────────────────────────────────────────────────────────

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model Account {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  code      String
  nameEn    String
  nameAr    String
  type      AccountType
  parentId  String?     @db.Uuid
  postable  Boolean     @default(true)
  /// Semantic role the posting engine resolves, e.g. ACCOUNTS_RECEIVABLE.
  role      String?
  currency  String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  createdBy String?     @db.Uuid
  updatedAt DateTime    @updatedAt
  updatedBy String?     @db.Uuid

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent       Account?      @relation("AccountTree", fields: [parentId], references: [id])
  children     Account[]     @relation("AccountTree")
  lines        JournalLine[]
  bankAccounts BankAccount[]

  @@unique([tenantId, code])
  @@unique([tenantId, role])
  @@index([tenantId])
  @@map("accounts")
}

enum FiscalPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

model FiscalPeriod {
  id        String             @id @default(uuid()) @db.Uuid
  tenantId  String             @db.Uuid
  name      String
  startsOn  DateTime           @db.Date
  endsOn    DateTime           @db.Date
  status    FiscalPeriodStatus @default(OPEN)
  closedAt  DateTime?
  closedBy  String?            @db.Uuid
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  entries JournalEntry[]

  @@unique([tenantId, startsOn])
  @@index([tenantId, startsOn, endsOn])
  @@map("fiscal_periods")
}

enum JournalStatus {
  DRAFT
  POSTED
  REVERSED
}

model JournalEntry {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  branchId     String        @db.Uuid
  number       String
  date         DateTime      @db.Date
  periodId     String?       @db.Uuid
  source       String
  sourceId     String?       @db.Uuid
  reference    String?
  memoEn       String?
  memoAr       String?
  currencyCode String        @default("SAR")
  exchangeRate Decimal       @default("1") @db.Decimal(18, 8)
  status       JournalStatus @default(POSTED)
  totalDebit   Decimal       @db.Decimal(18, 4)
  totalCredit  Decimal       @db.Decimal(18, 4)
  /// Set on the entry that reverses this one.
  reversedById String?       @unique @db.Uuid
  /// Recurring template this entry was generated from.
  recurringId  String?       @db.Uuid
  postedAt     DateTime      @default(now())
  createdAt    DateTime      @default(now())
  createdBy    String?       @db.Uuid
  updatedAt    DateTime      @updatedAt
  updatedBy    String?       @db.Uuid
  deletedAt    DateTime?

  period     FiscalPeriod? @relation(fields: [periodId], references: [id])
  reversedBy JournalEntry? @relation("Reversal", fields: [reversedById], references: [id])
  reverses   JournalEntry? @relation("Reversal")
  lines      JournalLine[]

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, source, sourceId])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  entryId        String   @db.Uuid
  lineNo         Int
  accountId      String   @db.Uuid
  branchId       String   @db.Uuid
  debit          Decimal  @default("0") @db.Decimal(18, 4)
  credit         Decimal  @default("0") @db.Decimal(18, 4)
  /// Amount in the document's own currency, when it is not SAR.
  currencyAmount Decimal? @db.Decimal(18, 4)
  partyId        String?  @db.Uuid
  itemId         String?  @db.Uuid
  employeeId     String?  @db.Uuid
  memoEn         String?
  memoAr         String?

  entry           JournalEntry     @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account         Account          @relation(fields: [accountId], references: [id])
  bankTransaction BankTransaction?

  @@unique([entryId, lineNo])
  @@index([tenantId, accountId])
  @@index([tenantId, partyId])
  @@map("journal_lines")
}

model Currency {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  code     String
  nameEn   String
  nameAr   String
  symbol   String?
  decimals Int     @default(2)
  active   Boolean @default(true)

  rates ExchangeRate[]

  @@unique([tenantId, code])
  @@map("currencies")
}

model ExchangeRate {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  currencyId String   @db.Uuid
  /// Units of base currency per one unit of the foreign currency.
  rate       Decimal  @db.Decimal(18, 8)
  validFrom  DateTime @db.Date
  source     String?
  createdAt  DateTime @default(now())

  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([currencyId, validFrom])
  @@index([tenantId])
  @@map("exchange_rates")
}

model BankAccount {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  accountId      String   @db.Uuid
  nameEn         String
  nameAr         String
  bankName       String?
  /// Encrypted at rest.
  iban           String?
  currencyCode   String   @default("SAR")
  openingBalance Decimal  @default("0") @db.Decimal(18, 4)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account      Account           @relation(fields: [accountId], references: [id])
  transactions BankTransaction[]

  @@index([tenantId])
  @@map("bank_accounts")
}

enum BankMatchStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model BankTransaction {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  bankAccountId String          @db.Uuid
  date          DateTime        @db.Date
  description   String?
  reference     String?
  debit         Decimal         @default("0") @db.Decimal(18, 4)
  credit        Decimal         @default("0") @db.Decimal(18, 4)
  balance       Decimal?        @db.Decimal(18, 4)
  status        BankMatchStatus @default(UNMATCHED)
  matchedLineId String?         @unique @db.Uuid
  /// Hash of the imported row, so re-importing a statement cannot duplicate it.
  importHash    String
  createdAt     DateTime        @default(now())

  bankAccount BankAccount  @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  matchedLine JournalLine? @relation(fields: [matchedLineId], references: [id])

  @@unique([bankAccountId, importHash])
  @@index([tenantId, date])
  @@map("bank_transactions")
}

// ─── Contacts ─────────────────────────────────────────────────────────────────────────────

model Party {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  code            String
  nameEn          String
  nameAr          String
  isCustomer      Boolean   @default(false)
  isSupplier      Boolean   @default(false)
  vatNumber       String?
  crNumber        String?
  /// ZATCA buyer identifier scheme when there is no VAT number: NAT, IQA, PAS, CRN, …
  identityScheme  String?
  identityValue   String?
  addressId       String?   @db.Uuid
  email           String?
  phone           String?
  whatsapp        String?
  /// Days from invoice date to due date.
  paymentTermDays Int       @default(0)
  creditLimit     Decimal   @default("0") @db.Decimal(18, 4)
  priceListId     String?   @db.Uuid
  openingBalance  Decimal   @default("0") @db.Decimal(18, 4)
  notes           String?
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  createdBy       String?   @db.Uuid
  updatedAt       DateTime  @updatedAt
  updatedBy       String?   @db.Uuid
  deletedAt       DateTime?

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  address        Address?        @relation(fields: [addressId], references: [id])
  priceList      PriceList?      @relation(fields: [priceListId], references: [id])
  contacts       PartyContact[]
  invoices       Invoice[]
  payments       Payment[]
  purchaseOrders PurchaseOrder[]
  bills          SupplierBill[]
  expenses       Expense[]

  @@unique([tenantId, code])
  @@index([tenantId, isCustomer])
  @@index([tenantId, isSupplier])
  @@map("parties")
}

model PartyContact {
  id        String  @id @default(uuid()) @db.Uuid
  tenantId  String  @db.Uuid
  partyId   String  @db.Uuid
  name      String
  title     String?
  email     String?
  phone     String?
  isPrimary Boolean @default(false)

  party Party @relation(fields: [partyId], references: [id], onDelete: Cascade)

  @@index([tenantId, partyId])
  @@map("party_contacts")
}

// ─── Inventory ────────────────────────────────────────────────────────────────────────────

enum ItemKind {
  STOCK
  SERVICE
  BUNDLE
  RAW_MATERIAL
  FINISHED_GOOD
}

model ItemCategory {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  nameEn   String
  nameAr   String
  parentId String? @db.Uuid

  parent   ItemCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ItemCategory[] @relation("CategoryTree")
  items    Item[]

  @@unique([tenantId, nameEn])
  @@map("item_categories")
}

model UnitOfMeasure {
  id         String  @id @default(uuid()) @db.Uuid
  tenantId   String  @db.Uuid
  code       String
  nameEn     String
  nameAr     String
  /// UN/ECE Recommendation 20 code, required by ZATCA on every invoice line.
  uneceCode  String  @default("PCE")
  /// Factor to the base unit of its family, e.g. 1000 for a kilogram of grams.
  factor     Decimal @default("1") @db.Decimal(18, 6)
  baseUnitId String? @db.Uuid

  baseUnit UnitOfMeasure?  @relation("UomTree", fields: [baseUnitId], references: [id])
  derived  UnitOfMeasure[] @relation("UomTree")
  items    Item[]

  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model Item {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  sku              String
  barcode          String?
  nameEn           String
  nameAr           String
  descriptionEn    String?
  descriptionAr    String?
  kind             ItemKind  @default(STOCK)
  categoryId       String?   @db.Uuid
  uomId            String    @db.Uuid
  /// Default selling price, exclusive of VAT unless the tenant prices inclusive.
  sellingPrice     Decimal   @default("0") @db.Decimal(18, 4)
  priceIncludesVat Boolean   @default(false)
  vatCategory      String    @default("STANDARD")
  /// Last purchase cost, used as the fallback when stock goes negative.
  lastCost         Decimal   @default("0") @db.Decimal(18, 4)
  reorderLevel     Decimal   @default("0") @db.Decimal(18, 6)
  trackLots        Boolean   @default(false)
  trackExpiry      Boolean   @default(false)
  imageUrl         String?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  createdBy        String?   @db.Uuid
  updatedAt        DateTime  @updatedAt
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ItemCategory?     @relation(fields: [categoryId], references: [id])
  uom            UnitOfMeasure     @relation(fields: [uomId], references: [id])
  movements      StockMovement[]
  balances       StockBalance[]
  invoiceLines   InvoiceLine[]
  priceListItems PriceListItem[]
  boms           BillOfMaterials[]
  bomLines       BomLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, barcode])
  @@index([tenantId, active])
  @@map("items")
}

model PriceList {
  id           String  @id @default(uuid()) @db.Uuid
  tenantId     String  @db.Uuid
  nameEn       String
  nameAr       String
  currencyCode String  @default("SAR")
  includesVat  Boolean @default(false)
  isDefault    Boolean @default(false)
  active       Boolean @default(true)

  items   PriceListItem[]
  parties Party[]

  @@unique([tenantId, nameEn])
  @@map("price_lists")
}

model PriceListItem {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  priceListId String  @db.Uuid
  itemId      String  @db.Uuid
  price       Decimal @db.Decimal(18, 4)
  minQuantity Decimal @default("0") @db.Decimal(18, 6)

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([priceListId, itemId, minQuantity])
  @@map("price_list_items")
}

model Warehouse {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  branchId String  @db.Uuid
  code     String
  nameEn   String
  nameAr   String
  active   Boolean @default(true)

  branch    Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements StockMovement[]
  balances  StockBalance[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model StockMovement {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  itemId         String    @db.Uuid
  warehouseId    String    @db.Uuid
  /// RECEIPT, ISSUE, TRANSFER_IN, TRANSFER_OUT, OPENING.
  kind           String
  date           DateTime  @db.Date
  quantity       Decimal   @db.Decimal(18, 6)
  unitCost       Decimal   @db.Decimal(18, 4)
  costAmount     Decimal   @db.Decimal(18, 4)
  /// Remaining quantity on this layer; FIFO only.
  layerRemaining Decimal?  @db.Decimal(18, 6)
  lotCode        String?
  expiresOn      DateTime? @db.Date
  source         String
  sourceId       String?   @db.Uuid
  reference      String?
  entryId        String?   @db.Uuid
  createdAt      DateTime  @default(now())
  createdBy      String?   @db.Uuid

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId, itemId, warehouseId, date])
  @@index([tenantId, source, sourceId])
  @@map("stock_movements")
}

model StockBalance {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  itemId      String   @db.Uuid
  warehouseId String   @db.Uuid
  quantity    Decimal  @default("0") @db.Decimal(18, 6)
  value       Decimal  @default("0") @db.Decimal(18, 4)
  updatedAt   DateTime @updatedAt

  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([itemId, warehouseId])
  @@index([tenantId])
  @@map("stock_balances")
}

enum DocumentStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  POSTED
  PARTIALLY_SETTLED
  SETTLED
  CANCELLED
  REVERSED
}

model StockCount {
  id          String         @id @default(uuid()) @db.Uuid
  tenantId    String         @db.Uuid
  warehouseId String         @db.Uuid
  number      String
  date        DateTime       @db.Date
  status      DocumentStatus @default(DRAFT)
  notes       String?
  entryId     String?        @db.Uuid
  createdAt   DateTime       @default(now())
  createdBy   String?        @db.Uuid
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  lines StockCountLine[]

  @@unique([tenantId, number])
  @@map("stock_counts")
}

model StockCountLine {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @db.Uuid
  stockCountId    String  @db.Uuid
  itemId          String  @db.Uuid
  systemQuantity  Decimal @db.Decimal(18, 6)
  countedQuantity Decimal @db.Decimal(18, 6)
  unitCost        Decimal @db.Decimal(18, 4)

  stockCount StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, itemId])
  @@map("stock_count_lines")
}

model BillOfMaterials {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  itemId         String   @db.Uuid
  nameEn         String
  nameAr         String
  /// Quantity of the finished good this recipe produces.
  outputQuantity Decimal  @default("1") @db.Decimal(18, 6)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  item             Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  lines            BomLine[]
  productionOrders ProductionOrder[]

  @@index([tenantId, itemId])
  @@map("bills_of_materials")
}

model BomLine {
  id          String  @id @default(uuid()) @db.Uuid
  tenantId    String  @db.Uuid
  bomId       String  @db.Uuid
  itemId      String  @db.Uuid
  quantityPer Decimal @db.Decimal(18, 6)
  /// Expected loss as a fraction, e.g. 0.05 for 5% trim.
  wastageRate Decimal @default("0") @db.Decimal(6, 4)

  bom  BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
