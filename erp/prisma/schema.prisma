  @@unique([payrollRunId, employeeId])
  @@index([tenantId, employeeId])
  @@map("payslips")
}

model Loan {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  employeeId  String   @db.Uuid
  principal   Decimal  @db.Decimal(18, 4)
  instalment  Decimal  @db.Decimal(18, 4)
  outstanding Decimal  @db.Decimal(18, 4)
  startsOn    DateTime @db.Date
  status      String   @default("ACTIVE")
  entryId     String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, employeeId])
  @@map("loans")
}

// ─── Platform ─────────────────────────────────────────────────────────────────────────────

model Attachment {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  /// Table the attachment belongs to, e.g. "invoices".
  entity      String
  entityId    String   @db.Uuid
  filename    String
  contentType String
  sizeBytes   Int
  storageKey  String
  uploadedBy  String?  @db.Uuid
  createdAt   DateTime @default(now())

  @@index([tenantId, entity, entityId])
  @@map("attachments")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String?   @db.Uuid
  kind      String
  titleEn   String
  titleAr   String
  bodyEn    String?
  bodyAr    String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, readAt])
  @@map("notifications")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  url       String
  events    String[]
  /// HMAC signing secret, encrypted at rest.
  secretEnc String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @db.Uuid
  webhookId     String    @db.Uuid
  event         String
  payload       Json
  attempt       Int       @default(0)
  httpStatus    Int?
  responseBody  String?
  deliveredAt   DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([tenantId, webhookId])
  @@map("webhook_deliveries")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String
  /// Only the hash is stored; the key itself is shown once at creation.
  keyHash     String    @unique
  prefix      String
  permissions String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  createdBy   String?   @db.Uuid

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}
