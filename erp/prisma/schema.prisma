model Payslip {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @db.Uuid
  payrollRunId    String   @db.Uuid
  employeeId      String   @db.Uuid
  /// Full earning and deduction lines as calculated, so a reprint is always faithful.
  earnings        Json
  deductions      Json
  grossPay        Decimal  @db.Decimal(18, 4)
  totalDeductions Decimal  @db.Decimal(18, 4)
  netPay          Decimal  @db.Decimal(18, 4)
