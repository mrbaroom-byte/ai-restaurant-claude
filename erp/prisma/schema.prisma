enum InvoiceKind {
  STANDARD
  SIMPLIFIED
}

enum InvoiceDocumentType {
  TAX_INVOICE
  CREDIT_NOTE
  DEBIT_NOTE
}

model Invoice {
  id                String              @id @default(uuid()) @db.Uuid
  tenantId          String              @db.Uuid
  branchId          String              @db.Uuid
  partyId           String?             @db.Uuid
  salesOrderId      String?             @db.Uuid
  number            String?
  /// UUID carried in the UBL document; generated at creation, immutable after.
  uuid              String              @unique @db.Uuid
  kind              InvoiceKind         @default(STANDARD)
  documentType      InvoiceDocumentType @default(TAX_INVOICE)
  /// Set on a credit or debit note: the invoice being corrected.
  originalInvoiceId String?             @db.Uuid
  correctionReason  String?
  status            DocumentStatus      @default(DRAFT)
  date              DateTime            @db.Date
  issuedAt          DateTime?
  dueDate           DateTime?           @db.Date
  supplyDate        DateTime?           @db.Date
  currencyCode      String              @default("SAR")
  exchangeRate      Decimal             @default("1") @db.Decimal(18, 8)
  isExport          Boolean             @default(false)

  taxableTotal       Decimal @default("0") @db.Decimal(18, 4)
  discountTotal      Decimal @default("0") @db.Decimal(18, 4)
  vatTotal           Decimal @default("0") @db.Decimal(18, 4)
  roundingAdjustment Decimal @default("0") @db.Decimal(18, 4)
  payableTotal       Decimal @default("0") @db.Decimal(18, 4)
  paidTotal          Decimal @default("0") @db.Decimal(18, 4)
  costOfSales        Decimal @default("0") @db.Decimal(18, 4)

  /// ZATCA chain values, assigned at posting and never changed.
  icv         Int?
  pih         String?
  invoiceHash String?
  qrBase64    String?
  signedXml   String?
  clearedXml  String?

  paymentMeansCode String?
  notes            String?
  entryId          String?   @db.Uuid
  posSaleId        String?   @unique @db.Uuid
  createdAt        DateTime  @default(now())
  createdBy        String?   @db.Uuid
  updatedAt        DateTime  @updatedAt
  updatedBy        String?   @db.Uuid
  deletedAt        DateTime?

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch              @relation(fields: [branchId], references: [id])
  party           Party?              @relation(fields: [partyId], references: [id])
  salesOrder      SalesOrder?         @relation(fields: [salesOrderId], references: [id])
  originalInvoice Invoice?            @relation("Correction", fields: [originalInvoiceId], references: [id])
  corrections     Invoice[]           @relation("Correction")
  lines           InvoiceLine[]
  submissions     ZatcaSubmission[]
  allocations     PaymentAllocation[]
  posSale         PosSale?            @relation(fields: [posSaleId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId, date])
  @@index([tenantId, status])
  @@index([tenantId, partyId])
  @@index([tenantId, icv])
  @@map("invoices")
}

model InvoiceLine {
  id            String  @id @default(uuid()) @db.Uuid
  tenantId      String  @db.Uuid
  invoiceId     String  @db.Uuid
  lineNo        Int
  itemId        String? @db.Uuid
  descriptionEn String
  descriptionAr String?
  unitCode      String  @default("PCE")
  quantity      Decimal @db.Decimal(18, 6)
  unitPrice     Decimal @db.Decimal(18, 4)
  discount      Decimal @default("0") @db.Decimal(18, 4)
  vatCategory   String  @default("STANDARD")
  vatRate       Decimal @default("0.15") @db.Decimal(6, 4)
  taxableAmount Decimal @db.Decimal(18, 4)
  vatAmount     Decimal @db.Decimal(18, 4)
  lineTotal     Decimal @db.Decimal(18, 4)
  unitCost      Decimal @default("0") @db.Decimal(18, 4)
  warehouseId   String? @db.Uuid
  /// POS modifiers, e.g. "no onion", stored as they were rung up.
  modifiers     Json?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?   @relation(fields: [itemId], references: [id])

  @@unique([invoiceId, lineNo])
  @@index([tenantId, itemId])
  @@map("invoice_lines")
}

enum ZatcaSubmissionStatus {
  PENDING
  CLEARED
  REPORTED
  REJECTED
  FAILED
}

model ZatcaSubmission {
  id            String                @id @default(uuid()) @db.Uuid
  tenantId      String                @db.Uuid
  invoiceId     String                @db.Uuid
  mode          String
  status        ZatcaSubmissionStatus @default(PENDING)
  attempt       Int                   @default(0)
  httpStatus    Int?
  /// ZATCA's response, stored whole. Never summarised, never discarded.
  responseBody  Json?
  warnings      Json?
  errors        Json?
  submittedAt   DateTime?
  nextAttemptAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, nextAttemptAt])
  @@index([invoiceId])
  @@map("zatca_submissions")
}

model ZatcaCertificate {
  id                  String           @id @default(uuid()) @db.Uuid
  tenantId            String           @db.Uuid
  branchId            String?          @db.Uuid
  environment         ZatcaEnvironment @default(SANDBOX)
  /// EGS serial: 1-<solution>|2-<model>|3-<serial>.
  egsSerial           String
  commonName          String
  invoiceType         String           @default("1100")
  /// All three encrypted at rest with the application key.
  privateKeyEnc       String
  csrPem              String?
  complianceCertEnc   String?
  complianceSecretEnc String?
  productionCertEnc   String?
  productionSecretEnc String?
  complianceRequestId String?
  status              String           @default("DRAFT")
  validFrom           DateTime?
  validTo             DateTime?
  /// Last invoice hash issued on this device — the next invoice's PIH.
  lastInvoiceHash     String?
  lastIcv             Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, environment, egsSerial])
  @@index([tenantId])
  @@map("zatca_certificates")
}

