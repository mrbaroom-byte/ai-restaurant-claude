enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  TERMINATED
}

model Employee {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @db.Uuid
  branchId           String         @db.Uuid
  employeeNumber     String
  nameEn             String
  nameAr             String
  /// Iqama for a resident, national ID for a Saudi. Encrypted at rest.
  identityNumber     String
  nationality        String
  isSaudi            Boolean        @default(false)
  jobTitleEn         String?
  jobTitleAr         String?
  department         String?
  hireDate           DateTime       @db.Date
  contractType       String         @default("UNLIMITED")
  basicSalary        Decimal        @default("0") @db.Decimal(18, 4)
  housingAllowance   Decimal        @default("0") @db.Decimal(18, 4)
  transportAllowance Decimal        @default("0") @db.Decimal(18, 4)
  otherAllowance     Decimal        @default("0") @db.Decimal(18, 4)
  /// Encrypted at rest.
  iban               String?
  gosiExempt         Boolean        @default(false)
  eosbAccrued        Decimal        @default("0") @db.Decimal(18, 4)
  iqamaExpiry        DateTime?      @db.Date
  passportExpiry     DateTime?      @db.Date
  contractExpiry     DateTime?      @db.Date
  status             EmployeeStatus @default(ACTIVE)
  terminationDate    DateTime?      @db.Date
  terminationReason  String?
  createdAt          DateTime       @default(now())
  createdBy          String?        @db.Uuid
  updatedAt          DateTime       @updatedAt
  updatedBy          String?        @db.Uuid
  deletedAt          DateTime?

