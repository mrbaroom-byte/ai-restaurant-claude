# ---- Core ----
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://user:pass@host:5432/postgres
# Supabase pooled connections need SSL; set to "false" only for a local Postgres.
DATABASE_SSL=true

# Public base URL of the deployed service (Railway gives you one).
PUBLIC_BASE_URL=https://health-os.up.railway.app
PORT=3000

# The profile holding personal health data. Locally this is a gitignored file;
# on a hosted deployment there is no file to mount, so pass it as one of:
#   PROFILE_B64  - base64 of config/profile.json  (preferred: survives dashboards)
#   PROFILE_JSON - the raw JSON on one line
# An inline value wins over the file path.
PROFILE_PATH=./config/profile.json
PROFILE_B64=
PROFILE_JSON=

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the only user allowed to talk to the bot.
TELEGRAM_CHAT_ID=
# Random string. Used as the webhook path segment AND as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# The build spec pinned claude-sonnet-4-6. Newer options: claude-sonnet-5, claude-opus-5.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Email fallback (Resend), optional ----
RESEND_API_KEY=
RESEND_FROM=health-os@yourdomain.com
RESEND_TO=

# ---- WHOOP (optional) ----
# Create an app at https://developer.whoop.com. Set its redirect URI to
#   $PUBLIC_BASE_URL/whoop/callback
# and its webhook URL to
#   $PUBLIC_BASE_URL/whoop/webhook
# Webhook deliveries are signed with the client secret below, so keep it secret.
# Without these the system runs exactly as before, on manual morning entry.
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# ---- Dashboard ----
# Random string; the dashboard is served at /dashboard?token=<this>
DASHBOARD_TOKEN=

# ---- Scheduler ----
# Set to false to run the service without the notification scheduler (e.g. a second replica).
SCHEDULER_ENABLED=true
