# ---- Core ----
# Postgres connection string (Supabase: Project Settings -> Database -> Connection string)
DATABASE_URL=postgresql://user:pass@host:5432/postgres
# Supabase pooled connections need SSL; set to "false" only for a local Postgres.
DATABASE_SSL=true

# Public base URL of the deployed service (Railway gives you one).
PUBLIC_BASE_URL=https://health-os.up.railway.app
PORT=3000

# Path to the profile file holding personal health data (gitignored).
PROFILE_PATH=./config/profile.json

# ---- Telegram ----
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric chat id of the only user allowed to talk to the bot.
TELEGRAM_CHAT_ID=
# Random string. Used as the webhook path segment AND as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# The build spec pinned claude-sonnet-4-6. Newer options: claude-sonnet-5, claude-opus-5.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Email fallback (Resend), optional ----
RESEND_API_KEY=
RESEND_FROM=health-os@yourdomain.com
RESEND_TO=

# ---- Dashboard ----
# Random string; the dashboard is served at /dashboard?token=<this>
DASHBOARD_TOKEN=

# ---- Scheduler ----
# Set to false to run the service without the notification scheduler (e.g. a second replica).
SCHEDULER_ENABLED=true
